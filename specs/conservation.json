{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 400,
  "title": "Crocodile Observations by Conservation Status",
  "data": {
    "url": "crocodile_dataset.csv"
  },
  "transform": [
    {
      "aggregate": [
        {
          "op": "count",
          "as": "count"
        },
        {
          "op": "distinct",
          "field": "Common Name",
          "as": "species"
        }
      ],
      "groupby": ["Conservation Status"]
    },
    {
      "sort": [
        {
          "field": "count",
          "order": "descending"
        }
      ]
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadius": 4
  },
  "encoding": {
    "x": {
      "field": "Conservation Status",
      "type": "nominal",
      "title": "Conservation Status",
      "axis": {
        "labelAngle": -45
      }
    },
    "y": {
      "field": "count",
      "type": "quantitative",
      "title": "Number of Observations"
    },
    "color": {
      "field": "Conservation Status",
      "type": "nominal",
      "scale": {
        "domain": [
          "Least Concern",
          "Vulnerable",
          "Critically Endangered",
          "Data Deficient"
        ],
        "range": [
          "#2c5f2d",
          "#f0ad4e",
          "#d9534f",
          "#5bc0de"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "Conservation Status",
        "type": "nominal",
        "title": "Status"
      },
      {
        "field": "count",
        "type": "quantitative",
        "title": "Observations"
      },
      {
        "field": "species",
        "type": "quantitative",
        "title": "Species Count"
      }
    ]
  }
}