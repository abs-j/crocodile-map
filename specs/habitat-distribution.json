{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": "container",
  "title": "Crocodile Observations by Habitat Type",
  "data": {
    "url": "crocodile_dataset.csv"
  },
  "transform": [
    {
      "aggregate": [
        {
          "op": "count",
          "as": "observation_count"
        },
        {
          "op": "distinct",
          "field": "Common Name",
          "as": "species_count"
        }
      ],
      "groupby": ["Habitat Type"]
    },
    {
      "sort": [
        {
          "field": "observation_count",
          "order": "descending"
        }
      ]
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadius": 4
  },
  "encoding": {
    "x": {
      "field": "observation_count",
      "type": "quantitative",
      "title": "Number of Observations"
    },
    "y": {
      "field": "Habitat Type",
      "type": "nominal",
      "title": "Habitat Type",
      "sort": {
        "field": "observation_count",
        "order": "descending"
      }
    },
    "color": {
      "field": "Habitat Type",
      "type": "nominal",
      "scale": {
        "scheme": "viridis"
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "Habitat Type",
        "type": "nominal",
        "title": "Habitat Type"
      },
      {
        "field": "observation_count",
        "type": "quantitative",
        "title": "Observations"
      },
      {
        "field": "species_count",
        "type": "quantitative",
        "title": "Species Count"
      }
    ]
  }
}
