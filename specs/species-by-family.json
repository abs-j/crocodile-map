{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": "container",
  "title": "Crocodile Species by Family and Conservation Status",
  "data": {
    "url": "crocodile_species_info.csv"
  },
  "transform": [
    {
      "aggregate": [
        {
          "op": "count",
          "as": "species_count"
        }
      ],
      "groupby": ["Family", "Conservation Status"]
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadius": 4
  },
  "encoding": {
    "x": {
      "field": "species_count",
      "type": "quantitative",
      "title": "Number of Species"
    },
    "y": {
      "field": "Family",
      "type": "nominal",
      "title": "Family"
    },
    "color": {
      "field": "Conservation Status",
      "type": "nominal",
      "scale": {
        "domain": [
          "Least Concern",
          "Vulnerable",
          "Critically Endangered",
          "Data Deficient"
        ],
        "range": [
          "#2c5f2d",
          "#f0ad4e",
          "#d9534f",
          "#5bc0de"
        ]
      },
      "title": "Conservation Status"
    },
    "tooltip": [
      {
        "field": "Family",
        "type": "nominal",
        "title": "Family"
      },
      {
        "field": "Conservation Status",
        "type": "nominal",
        "title": "Conservation Status"
      },
      {
        "field": "species_count",
        "type": "quantitative",
        "title": "Number of Species"
      }
    ]
  }
}
