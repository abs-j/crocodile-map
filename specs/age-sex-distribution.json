{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": "container",
  "title": "Crocodile Observations by Age Class and Sex",
  "data": {
    "url": "crocodile_dataset.csv"
  },
  "transform": [
    {
      "filter": "datum.Sex != 'Unknown'"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "count"
        }
      ],
      "groupby": ["Age Class", "Sex"]
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadius": 4
  },
  "encoding": {
    "x": {
      "field": "Age Class",
      "type": "nominal",
      "title": "Age Class"
    },
    "y": {
      "field": "count",
      "type": "quantitative",
      "title": "Number of Observations"
    },
    "color": {
      "field": "Sex",
      "type": "nominal",
      "scale": {
        "domain": ["Male", "Female"],
        "range": ["#2c5f2d", "#8B4513"]
      },
      "title": "Sex"
    },
    "tooltip": [
      {
        "field": "Age Class",
        "type": "nominal",
        "title": "Age Class"
      },
      {
        "field": "Sex",
        "type": "nominal",
        "title": "Sex"
      },
      {
        "field": "count",
        "type": "quantitative",
        "title": "Observations"
      }
    ]
  }
}
